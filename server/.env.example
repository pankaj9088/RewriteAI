# RewriteAI Backend — Environment Variables Template
# Copy this file to `.env` and fill in your values.
# The `.env` file is git-ignored and MUST NOT be committed.

# --- Required ---
# Your Google Gemini API key (get one from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# --- Optional ---
# Port to listen on (Render will inject this automatically)
PORT=3000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Extra allowed CORS origins (comma-separated). Leave blank unless you need
# specific web domains to call the API directly.
# Example: ALLOWED_ORIGINS=https://your-website.com,https://another-domain.com
ALLOWED_ORIGINS=
